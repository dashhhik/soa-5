{
  "uid": "online-cinema-analytics",
  "title": "Online Cinema Analytics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Retention Cohort Heatmap Day 0-7",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "format": "table",
          "rawSql": "SELECT\n  toString(cohort_date) AS cohort_date,\n  round(sumIf(retention_rate, day_number = 0) * 100, 2) AS \"Day 0\",\n  round(sumIf(retention_rate, day_number = 1) * 100, 2) AS \"Day 1\",\n  round(sumIf(retention_rate, day_number = 2) * 100, 2) AS \"Day 2\",\n  round(sumIf(retention_rate, day_number = 3) * 100, 2) AS \"Day 3\",\n  round(sumIf(retention_rate, day_number = 4) * 100, 2) AS \"Day 4\",\n  round(sumIf(retention_rate, day_number = 5) * 100, 2) AS \"Day 5\",\n  round(sumIf(retention_rate, day_number = 6) * 100, 2) AS \"Day 6\",\n  round(sumIf(retention_rate, day_number = 7) * 100, 2) AS \"Day 7\"\nFROM analytics.v_retention_movie_events\nGROUP BY cohort_date\nORDER BY cohort_date DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 25
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cohort_date"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DAU",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "format": "time_series",
          "rawSql": "SELECT\n  event_date AS time,\n  dau AS value,\n  'DAU' AS metric\nFROM analytics.v_dau_movie_events\nORDER BY event_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Conversion",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "format": "time_series",
          "rawSql": "SELECT\n  event_date AS time,\n  conversion_rate AS value,\n  'Conversion' AS metric\nFROM analytics.v_conversion_movie_events\nORDER BY event_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top movies",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "format": "table",
          "rawSql": "SELECT\n  toString(event_date) AS event_date,\n  movie_id,\n  view_count,\n  movie_rank\nFROM analytics.v_top_movies_movie_events\nORDER BY event_date DESC, movie_rank ASC, movie_id ASC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Average watch time",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "format": "time_series",
          "rawSql": "SELECT\n  event_date AS time,\n  avg_watch_time_seconds AS value,\n  'Average watch time' AS metric\nFROM analytics.v_avg_watch_time_movie_events\nORDER BY event_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
