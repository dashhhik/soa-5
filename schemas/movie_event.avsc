{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "movie.analytics",
  "doc": "Canonical movie event contract for the analytics pipeline.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique event identifier."
    },
    {
      "name": "user_id",
      "type": "string",
      "doc": "User identifier and Kafka partition key."
    },
    {
      "name": "movie_id",
      "type": "string",
      "doc": "Movie identifier."
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "VIEW_STARTED",
          "VIEW_PAUSED",
          "VIEW_RESUMED",
          "VIEW_FINISHED",
          "LIKED",
          "SEARCHED"
        ]
      }
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "UTC timestamp."
    },
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": [
          "MOBILE",
          "DESKTOP",
          "TV",
          "TABLET"
        ]
      }
    },
    {
      "name": "session_id",
      "type": "string",
      "doc": "Session identifier."
    },
    {
      "name": "progress_seconds",
      "type": "int",
      "doc": "Non-negative playback progress in seconds."
    }
  ]
}
